{
  "rules": {
    "players": {
      ".read": true,
      "$id": {
        ".write": "$id.matches(/^[a-z0-9-]{1,40}$/)",
        ".validate": "newData.hasChildren(['name', 'handicap'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "handicap": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 54"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "weeks": {
      ".read": true,
      "$week": {
        ".write": "$week.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && (!newData.exists() || newData.hasChildren(['courseName', 'par']))",
        "courseName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "par": {
          ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 80"
        },
        "scores": {
          "$player": {
            ".validate": "$player.matches(/^[a-z0-9-]{1,40}$/) && newData.isNumber() && newData.val() >= 40 && newData.val() <= 160"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "round": {
      ".read": true,
      ".write": "newData.hasChildren(['courseName', 'par'])",
      "courseName": {
        ".validate": "newData.isString() && newData.val().length <= 80"
      },
      "par": {
        ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 80"
      },
      "mokodileGross": {
        ".validate": "newData.isNumber() && newData.val() >= 40 && newData.val() <= 160"
      },
      "rondonGross": {
        ".validate": "newData.isNumber() && newData.val() >= 40 && newData.val() <= 160"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
